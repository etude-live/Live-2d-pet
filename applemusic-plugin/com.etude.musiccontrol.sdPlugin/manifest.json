{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Apple Music 컨트롤",
	"Version": "1.0.0.0",
	"Author": "etude-live",
	"Description": "Mac 의 Music 앱(Apple Music)을 재생/일시정지, 이전 곡, 다음 곡 버튼으로 조작해요.",
	"URL": "https://github.com/etude-live/Live-2d-pet",
	"Category": "Apple Music 컨트롤",
	"CategoryIcon": "imgs/plugin/category",
	"Icon": "imgs/plugin/icon",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "20",
		"Debug": "enabled"
	},
	"UUID": "com.etude.musiccontrol",
	"Actions": [
		{
			"Name": "⏮ 이전 곡",
			"UUID": "com.etude.musiccontrol.previous",
			"Icon": "imgs/actions/previous/icon",
			"Tooltip": "이전 곡으로 (곡 중간이면 처음으로). Music 이 꺼져 있으면 열어요.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/previous/key",
					"TitleAlignment": "bottom",
					"FontSize": 11,
					"ShowTitle": true
				}
			]
		},
		{
			"Name": "⏯ 재생 / 일시정지",
			"UUID": "com.etude.musiccontrol.playpause",
			"Icon": "imgs/actions/playpause/icon",
			"Tooltip": "재생과 일시정지. 재생 중이면 곡 제목을 보여 줘요. Music 이 꺼져 있으면 열어요.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/playpause/key",
					"TitleAlignment": "bottom",
					"FontSize": 11,
					"ShowTitle": true
				}
			]
		},
		{
			"Name": "⏭ 다음 곡",
			"UUID": "com.etude.musiccontrol.next",
			"Icon": "imgs/actions/next/icon",
			"Tooltip": "다음 곡으로. Music 이 꺼져 있으면 열어요.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": true,
			"States": [
				{
					"Image": "imgs/actions/next/key",
					"TitleAlignment": "bottom",
					"FontSize": 11,
					"ShowTitle": true
				}
			]
		}
	]
}
